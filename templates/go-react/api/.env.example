# Application
PORT=8080
APP_ENV=development
LOG_LEVEL=info

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# Local: postgres://myapp:myapp@localhost:5432/myapp?sslmode=disable
# Docker: postgres://myapp:myapp@postgres:5432/myapp?sslmode=disable
DATABASE_URL=postgres://myapp:myapp@localhost:5432/myapp?sslmode=disable

# Auth
JWT_SECRET=your-secret-key-change-in-production
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Avatar storage (S3-compatible, e.g. Contabo Object Storage).
# If AVATAR_S3_BUCKET is empty, the API falls back to local /var/www/files/avatars.
AVATAR_S3_BUCKET=
AVATAR_S3_REGION=
AVATAR_S3_ENDPOINT=
AVATAR_S3_PUBLIC_BASE_URL=
AVATAR_S3_ACCESS_KEY_ID=
AVATAR_S3_SECRET_ACCESS_KEY=
