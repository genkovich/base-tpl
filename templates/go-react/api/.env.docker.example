# Env локального compose-стека. Скопіюй у api/.env.docker (gitignored) і за
# потреби заповни реальні GOOGLE_* — без них стек живий, але логін не пройде.

# Application
PORT=8080
APP_ENV=development
LOG_LEVEL=info

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Postgres container init (consumed by postgres:18-alpine image)
POSTGRES_USER=myapp
POSTGRES_PASSWORD=myapp
POSTGRES_DB=myapp
# postgres:18 changed the data layout; pin PGDATA to a subdir of the mounted volume
# so the image stops crash-looping on the legacy /var/lib/postgresql/data mount.
PGDATA=/var/lib/postgresql/data/pgdata

# Database — api service reaches postgres over the compose network
DATABASE_URL=postgres://myapp:myapp@postgres:5432/myapp?sslmode=disable

# Auth (dev placeholders)
JWT_SECRET=dev-secret-change-me
GOOGLE_CLIENT_ID=dummy-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
