# /opt/myapp/.env на VPS. Секрети живуть тільки тут — не в репо.
DOMAIN=myapp.example.com
# battery:observability
GRAFANA_DOMAIN=grafana.myapp.example.com
# /battery:observability
IMAGE_TAG=latest

POSTGRES_USER=myapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=myapp
DATABASE_URL=postgres://myapp:change-me@postgres:5432/myapp?sslmode=disable

JWT_SECRET=change-me
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# battery:observability
GRAFANA_ADMIN_PASSWORD=change-me
# /battery:observability
