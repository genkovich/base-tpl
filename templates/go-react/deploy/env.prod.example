# /opt/myapp/.env на VPS — заповнюється в блоці B5 (pre-provisioning).
DOMAIN=myapp.example.com
GRAFANA_DOMAIN=grafana.myapp.example.com
IMAGE_TAG=latest

POSTGRES_USER=myapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=myapp
DATABASE_URL=postgres://myapp:change-me@postgres:5432/myapp?sslmode=disable

JWT_SECRET=change-me
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

GRAFANA_ADMIN_PASSWORD=change-me
