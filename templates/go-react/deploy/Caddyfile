# {$DOMAIN} — основний застосунок; домени приходять з .env на VPS.
# battery:observability
# {$GRAFANA_DOMAIN} — Grafana з метриками.
# /battery:observability

{$DOMAIN} {
	# Стискаємо лише перелічені типи: дефолтний match encode покриває text/*,
	# куди підпадає text/event-stream — стиснутий SSE-стрім Caddy буферизує
	# цілком і клієнт не бачить ані байта (жоден flush_interval не рятує).
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
		}
	}

	handle /api/* {
		reverse_proxy api:8080
	}
	# Health-и наживо з домену — по /readyz гейтиться деплой.
	handle /livez {
		reverse_proxy api:8080
	}
	handle /readyz {
		reverse_proxy api:8080
	}
	# Локальне файлове сховище (аватари) віддає API.
	handle /files/* {
		reverse_proxy api:8080
	}
	# battery:web
	handle {
		reverse_proxy web:80
	}
	# /battery:web
}

# battery:observability
{$GRAFANA_DOMAIN} {
	reverse_proxy grafana:3000
}
# /battery:observability
